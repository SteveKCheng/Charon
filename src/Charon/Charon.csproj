<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Charon</RootNamespace>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <TargetName Condition="'$(_IsPublishing)' == 'true'">charon</TargetName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <EmbeddedResource Include="index.html" LogicalName="index.html" />
    <InternalsVisibleTo Include="Charon.Tests" />
  </ItemGroup>

</Project>
